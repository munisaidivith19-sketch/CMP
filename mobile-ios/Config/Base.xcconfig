// Shared build settings. Safe, non-secret values only.
//
// VEXON_API_BASE_URL: server root WITHOUT /api, e.g. https://vexon.example.edu
// (xcconfig treats "//" as a comment, so URLs are written with $(SLASH)$(SLASH)).
SLASH = /

VEXON_BUNDLE_ID = com.vexon.campus
VEXON_DEVELOPMENT_TEAM =

// Optional, git-ignored per-machine overrides (team id, local server).
#include? "Local.xcconfig"
