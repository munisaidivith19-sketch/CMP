<?xml version="1.0" encoding="utf-8"?>
<!-- The refresh token is encrypted with a device-bound Keystore key; a backup restored
     on another phone could not decrypt it, so app data is never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
