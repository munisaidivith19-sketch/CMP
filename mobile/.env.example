# Address of the Vexon / CampusConnect backend the app talks to (no trailing slash).
# Physical phone on the same Wi-Fi as your computer: use the computer's LAN IP.
# Deployed server: its https:// URL. Leave empty in development to auto-use the
# machine running `npx expo start`.
EXPO_PUBLIC_API_URL=
# Set after `npx eas init` (needed for push notifications).
EAS_PROJECT_ID=
