# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# ── MongoDB ────────────────────────────────────────────
# DB_TARGET picks which database the server uses: "local" or "atlas".
# Both connection strings can be set at once; switching is just this one value.
DB_TARGET=local
# Local (MongoDB Community Server):
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
# MongoDB Atlas (free tier) — needed to deploy somewhere real (see render.yaml
# / README "Using the app over the internet"). Set DB_TARGET=atlas to use it:
MONGO_URI_ATLAS=
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# Set to 1 when deployed behind a reverse proxy (Render, etc.) so rate limiting
# sees the real visitor IP. Leave unset for local development.
# TRUST_PROXY=1

# Comma-separated list of allowed front-end origins
CLIENT_URL=http://localhost:5173

# ── Auth (CHANGE THESE — use long random strings) ─────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Uploads ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ── Optional: Cloudinary (leave blank to store files locally) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Password-reset email (SMTP) ───────────────────────
# Public URL of the web app, used in reset links.
APP_URL=http://localhost:5173
# Leave SMTP_HOST blank to disable email (reset requests are then accepted but no
# email can be sent — the server logs a warning, never the token).
# For local testing Mailpit works: SMTP_HOST=127.0.0.1 SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusConnect <no-reply@campus.local>
PASSWORD_RESET_MINUTES=15

# ── Mobile push (Expo) — optional ─────────────────────
EXPO_ACCESS_TOKEN=

# ── Native Android push (FCM) — optional ──────────────
# Firebase console → Project settings → Service accounts → Generate new private
# key. Put the JSON (or base64 of it) here, or a path in FCM_SERVICE_ACCOUNT_FILE.
# Never commit the real value. Unset = push disabled (in-app notifications still work).
FCM_SERVICE_ACCOUNT=
FCM_SERVICE_ACCOUNT_FILE=
# When the daily attendance digest goes to HODs / Principal / Office (campus time).
DIGEST_TIME=17:30

# ── College bus tracking ──────────────────────────────
# Map style (vector tiles) for web + Android. Default: OpenFreeMap (no key).
# A keyed provider puts its PUBLIC client key in this URL (never a secret), e.g.
# https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_PUBLIC_KEY
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=© OpenFreeMap · © OpenMapTiles · Data © OpenStreetMap contributors
# Extra https origins the style loads tiles / glyphs / sprites from (comma-separated), for the CSP.
MAP_CSP_ORIGINS=
# all = every student sees every bus; assigned = students see only their assigned route / bus.
TRANSPORT_STUDENT_VISIBILITY=all
# Location history retention (days) and freshness thresholds (seconds).
TRANSPORT_LOCATION_RETENTION_DAYS=7
TRANSPORT_LIVE_SECONDS=60
TRANSPORT_STALE_SECONDS=300
# GPS validation.
GPS_MAX_AGE_SECONDS=120
GPS_MAX_FUTURE_SECONDS=30
GPS_MAX_ACCURACY_M=100
GPS_MAX_SPEED_MPS=33
GPS_MIN_INTERVAL_MS=2000
GPS_HISTORY_INTERVAL_MS=10000
# Trips end by themselves after this long without a fix / at most this long.
TRIP_IDLE_MINUTES=15
TRIP_MAX_HOURS=5
TRACKING_LOST_MINUTES=5
BUS_APPROACHING_MINUTES=5
# Vehicle GPS tracker webhook (POST /api/transport/tracker/locations, HMAC-signed).
# Unset = the webhook is disabled. Long random value; never commit the real one.
TRACKER_WEBHOOK_SECRET=

# ── Chat encryption at rest ───────────────────────────
# Long random string. Chat message bodies are AES-256-GCM encrypted in MongoDB
# with a key derived from this. Changing it makes existing messages unreadable.
CHAT_ENCRYPTION_KEY=replace_with_a_long_random_string

# ── Gate pass parent OTP ──────────────────────────────
# SMS sending switch. While false (the default) OTPs are still generated,
# stored and verified normally, nothing is sent, and Admins read them in
# Security & Logs → OTP. To go live: OTP_SMS_ENABLED=true, OTP_PROVIDER=college_sms
# and the SMS_* values below. OTPs only ever go to the student's registered
# parent mobile number from the database.
OTP_SMS_ENABLED=false
# Sender used when OTP_SMS_ENABLED=true: "college_sms" = the college SMS vendor
# (adapter in services/otp/providers/collegeSmsProvider.js, to be connected).
OTP_PROVIDER=college_sms
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=4
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Legacy development portal at /dev/otp (superseded by Security & Logs → OTP).
# Off in production unless set.
# DEV_OTP_PORTAL=true
# College SMS vendor — leave blank until the college provides them. Never commit real values.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
# Template ID of the "GATE PASS APPROVED" (student left campus) template.
SMS_EXIT_TEMPLATE_ID=
# Vendor endpoint. Must be https:// in production (the key is in the query string).
SMS_API_URL=https://bulksms.2020sms.com/vb/apikey.php
# Only if the vendor has no HTTPS endpoint: "true" lets production send over
# http:// (the key, parent number and OTP then travel unencrypted).
SMS_ALLOW_INSECURE_HTTP=false

# ── Gate pass return-to-campus location check ─────────
# The student's phone sends one GPS reading; the server decides. The reading
# must be within the radius of the college point, at most MAX_ACCURACY meters
# uncertain, and taken within MAX_AGE seconds of the server's clock.
COLLEGE_LATITUDE=13.263803
COLLEGE_LONGITUDE=80.108414
LOCATION_GEOFENCE_RADIUS_METERS=500
LOCATION_MAX_ACCURACY_METERS=50
LOCATION_MAX_AGE_SECONDS=30
# How long the return QR/code is valid after a successful location check.
RETURN_CREDENTIAL_MINUTES=15

# ── JNN Study Assistant (Groq) ────────────────────────
# Backend-only. Never put this key in the client/mobile apps or commit a real one.
# To rotate: replace the value here in your real .env and restart the server.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set to false to disable Groq browser_search (web research) entirely.
AI_WEB_SEARCH_ENABLED=true
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_OUTPUT_TOKENS=1500
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60
# Messages stored per conversation (oldest trimmed) / recent messages sent as context.
AI_MAX_CONVERSATION_MESSAGES=30
AI_HISTORY_MESSAGES=10
# Simultaneous Groq calls from this server, and how many may wait in line.
AI_MAX_CONCURRENT=20
AI_MAX_QUEUE=100
# Study-material excerpts retrieved per question.
AI_RAG_CHUNKS=6

# ── Super Admin / emergency control (docs/SUPER_ADMIN.md) ──
# JSON status written by your backup job: {"lastBackupAt","lastVerifiedAt","lastResult"}.
BACKUP_STATUS_FILE=
# Break-glass: "normal" forces normal operation whatever the stored emergency mode.
PLATFORM_MODE_OVERRIDE=

# ── Super Admin SOC & troubleshooting (docs/SOC.md) ──
# Set to false to stop recording errors (the health page then reports the pipeline as FAIL).
SOC_CAPTURE_ENABLED=true
# Label stored with every error and run (defaults to NODE_ENV), e.g. production / staging.
SOC_ENVIRONMENT=
# How long an error must stay quiet after "fix applied" before verification can pass (ms).
SOC_VERIFY_WINDOW_MS=900000
# Diagnostic runs at once in this process, and runs per Super Admin per 15 min.
SOC_DIAG_MAX_CONCURRENT=3
SOC_RUN_RATE_LIMIT=60

# ── Skill Wallet (docs/SKILL_WALLET.md) ──
# Private file store for certificates and project images: "disk" (default in
# development, under SKILL_WALLET_PRIVATE_DIR) or "db" (MongoDB; default in production
# because hosted disks such as Render's are wiped on deploy). Never the public /uploads.
SKILL_WALLET_PRIVATE_STORAGE=
SKILL_WALLET_PRIVATE_DIR=private-uploads
# Signs short-lived, viewer-bound file URLs. When empty a key is derived from the access-token secret;
# set a separate random value (32+ chars) in production.
SKILL_WALLET_ASSET_URL_SECRET=
SKILL_WALLET_ASSET_URL_MINUTES=10
# Upload limits. Every NPTEL certificate is decoded and re-encoded to WebP on the server.
SKILL_WALLET_CERT_MAX_MB=5
SKILL_WALLET_IMAGE_MAX_MB=5
SKILL_WALLET_MAX_IMAGE_PIXELS=40000000
SKILL_WALLET_MAX_IMAGE_DIMENSION=8000
SKILL_WALLET_MIN_IMAGE_DIMENSION=64
SKILL_WALLET_WEBP_QUALITY=85
# Teams and housekeeping.
SKILL_WALLET_INVITE_EXPIRY_DAYS=14
SKILL_WALLET_MAX_TEAM_SIZE=8
SKILL_WALLET_ORPHAN_ASSET_HOURS=24
# Per-user rate limits (writes/min, uploads & invitations /10 min, comments /5 min,
# contact requests /hour) and the per-IP public gallery limit (/min).
SKILL_WALLET_WRITE_LIMIT=60
SKILL_WALLET_UPLOAD_LIMIT=20
SKILL_WALLET_INVITE_LIMIT=20
SKILL_WALLET_COMMENT_LIMIT=20
SKILL_WALLET_CONTACT_LIMIT=10
SKILL_WALLET_PUBLIC_LIMIT=300
