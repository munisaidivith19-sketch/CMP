# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# ── MongoDB ────────────────────────────────────────────
# DB_TARGET picks which database the server uses: "local" or "atlas".
# Both connection strings can be set at once; switching is just this one value.
DB_TARGET=local
# Local (MongoDB Community Server):
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
# MongoDB Atlas (free tier) — needed to deploy somewhere real (see render.yaml
# / README "Using the app over the internet"). Set DB_TARGET=atlas to use it:
MONGO_URI_ATLAS=
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# Set to 1 when deployed behind a reverse proxy (Render, etc.) so rate limiting
# sees the real visitor IP. Leave unset for local development.
# TRUST_PROXY=1

# HTTPS enforcement (default: on in production, off in development). When on,
# plain-HTTP page loads are redirected to APP_URL (which must be https://),
# plain-HTTP writes and realtime connections are refused, and HSTS is sent.
# Set false ONLY for a plain-HTTP campus server with no TLS in front of it.
# FORCE_HTTPS=true

# Comma-separated list of allowed front-end origins
CLIENT_URL=http://localhost:5173

# ── Auth (CHANGE THESE — use long random strings) ─────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Sign-in CAPTCHA (Cloudflare Turnstile) — optional ──
# Off until BOTH keys are set. When on, a web sign-in from a network that has
# failed recently (2 wrong passwords on that email, or 5 on any account from
# that IP) must pass a CAPTCHA instead of being locked out — so a stranger on
# the shared college Wi-Fi cannot lock anyone out. The Android app and Gate
# Scanner keep the per-network locks. Create a "Managed" widget at
# https://dash.cloudflare.com → Turnstile, with your site's hostname (plus
# localhost for development). The secret stays server-side only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Hostnames a token may come from (comma-separated). Unset = the hostnames of
# CLIENT_URL / APP_URL. Never list localhost on the production server.
TURNSTILE_HOSTNAMES=

# ── Uploads ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ── Optional: Cloudinary (leave blank to store files locally) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Password-reset email (SMTP) ───────────────────────
# Public URL of the web app, used in reset links.
APP_URL=http://localhost:5173
# Leave SMTP_HOST blank to disable email (reset requests are then accepted but no
# email can be sent — the server logs a warning, never the token).
# For local testing Mailpit works: SMTP_HOST=127.0.0.1 SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusConnect <no-reply@campus.local>

# ── Where the IT support account works ──
# Addresses or CIDR ranges, comma-separated. Anywhere else the account behaves
# as if it did not exist (the right password is answered as "Invalid email or
# password") and sessions used from outside are ended. Default: this server only.
# Example with the IT office VLAN: 127.0.0.1,::1,172.16.20.0/24
# TRUST_PROXY must match reality (0/false when nothing sits in front of the app).
CONSOLE_ALLOWED_NETWORKS=127.0.0.1,::1

# ── Security alert emails (Resend) ──
# IT support sign-ins and failed sign-ins, Admin account creation attempts,
# Backup & recovery use and Emergency Control. Sent from a domain verified in
# Resend (jnn.edu.in). SECURITY_ALERT_TO: one or more addresses, comma-separated.
# Keep the API key secret: set it here and in Render's environment only.
RESEND_API_KEY=
SECURITY_ALERT_FROM=J.N.N Security <tech@jnn.edu.in>
SECURITY_ALERT_TO=
PASSWORD_RESET_MINUTES=15
# Days a deleted user account can still be restored (by creating the same email again) before it is removed for good.
USER_DELETE_GRACE_DAYS=15

# ── Mobile push (Expo) — optional ─────────────────────
EXPO_ACCESS_TOKEN=

# ── Native Android push (FCM) — optional ──────────────
# Firebase console → Project settings → Service accounts → Generate new private
# key. Put the JSON (or base64 of it) here, or a path in FCM_SERVICE_ACCOUNT_FILE.
# Never commit the real value. Unset = push disabled (in-app notifications still work).
FCM_SERVICE_ACCOUNT=
FCM_SERVICE_ACCOUNT_FILE=
# When the daily attendance digest goes to HODs / Principal / Office (campus time).
DIGEST_TIME=17:30

# ── College bus tracking ──────────────────────────────
# Map style (vector tiles) for web + Android. Default: OpenFreeMap (no key).
# A keyed provider puts its PUBLIC client key in this URL (never a secret), e.g.
# https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_PUBLIC_KEY
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=© OpenFreeMap · © OpenMapTiles · Data © OpenStreetMap contributors
# Extra https origins the style loads tiles / glyphs / sprites from (comma-separated), for the CSP.
MAP_CSP_ORIGINS=
# all = every student sees every bus; assigned = students see only their assigned route / bus.
TRANSPORT_STUDENT_VISIBILITY=all
# Location history retention (days) and freshness thresholds (seconds).
TRANSPORT_LOCATION_RETENTION_DAYS=7
TRANSPORT_LIVE_SECONDS=60
TRANSPORT_STALE_SECONDS=300
# GPS validation.
GPS_MAX_AGE_SECONDS=120
GPS_MAX_FUTURE_SECONDS=30
GPS_MAX_ACCURACY_M=100
GPS_MAX_SPEED_MPS=33
GPS_MIN_INTERVAL_MS=2000
GPS_HISTORY_INTERVAL_MS=10000
# Trips end by themselves after this long without a fix / at most this long.
TRIP_IDLE_MINUTES=15
TRIP_MAX_HOURS=5
TRACKING_LOST_MINUTES=5
BUS_APPROACHING_MINUTES=5
# Journey history (trips + stop arrival/departure events) is kept this many days
# (30–730), then removed automatically. Changing it later needs the `retention`
# TTL indexes on bustrips / busstopevents dropped so they are rebuilt.
TRANSPORT_JOURNEY_RETENTION_DAYS=365
# Stop arrival / departure detection (server-side, from accepted GPS fixes).
# Arrival radius in metres (a stop can override it), the worst fix accuracy
# used as evidence, fixes needed to confirm (a bus standing still — speed at or
# below STOP_DWELL_SPEED_MPS — confirms with one), and the extra distance past
# the radius before a departure counts.
STOP_ARRIVAL_RADIUS_M=50
STOP_ARRIVAL_MAX_ACCURACY_M=50
STOP_ARRIVAL_CONFIRM_FIXES=2
STOP_DWELL_SPEED_MPS=2
STOP_DEPARTURE_MARGIN_M=30
# Farther than this from the route = off route (no progress, no stop events).
ROUTE_OFF_ROUTE_M=500
# A trip completes itself on reaching its final stop (true/false), once it has
# covered at least TRIP_MIN_TRAVEL_M (or a quarter of the route, if shorter).
TRIP_AUTO_COMPLETE=true
TRIP_MIN_TRAVEL_M=1000
# ETAs: the fallback speed used before anything is measured (shown as
# "approximate"), dwell per intermediate stop, and how many recorded trips a
# stop-to-stop segment needs before its measured history is used.
ETA_DEFAULT_SPEED_KMH=20
ETA_DWELL_SECONDS=30
ETA_HISTORY_MIN_TRIPS=3
# Reports: minimum trips behind an average; ± minutes counted as on time.
TRANSPORT_REPORT_MIN_TRIPS=3
TRANSPORT_ON_TIME_MINUTES=5
# Road-following route geometry ("Generate road route" in Manage buses → Routes).
# OSRM server, called from the backend only (no key). Default: the public OSRM
# demo server — fair use only (~1 request/s, no uptime guarantee; see
# https://github.com/Project-OSRM/osrm-backend/wiki/Demo-server). For production,
# self-host OSRM with your region's OpenStreetMap extract and put its URL here.
# Empty = generation disabled (pasting geometry still works).
ROUTING_OSRM_URL=https://router.project-osrm.org
ROUTING_OSRM_PROFILE=driving
ROUTING_TIMEOUT_MS=10000
# A stop farther than this (m) from a road the router knows is an error.
ROUTING_MAX_SNAP_M=250
# Minimum spacing between calls to the routing server (ms, whole process).
ROUTING_MIN_INTERVAL_MS=1100
# A bus farther than this (m, and than its GPS accuracy) from its route line is
# off route: the map shows the ROAD path back to the route from the router above,
# never a straight line. Re-requested after the bus moves ROUTE_DETOUR_REFRESH_M
# or the path is ROUTE_DETOUR_MAX_AGE_SECONDS old; a bus-detail request waits at
# most ROUTE_DETOUR_WAIT_MS for a new one.
ROUTE_DETOUR_MIN_M=75
ROUTE_DETOUR_REFRESH_M=150
ROUTE_DETOUR_MAX_AGE_SECONDS=300
ROUTE_DETOUR_WAIT_MS=2500
# Route generations per manager per minute.
ROUTING_RATE_LIMIT=10
# Saved geometry must pass within this distance (m) of every stop.
ROUTE_GEOMETRY_MAX_STOP_OFFSET_M=500
# Vehicle GPS tracker webhook (POST /api/transport/tracker/locations, HMAC-signed).
# Unset = the webhook is disabled. Long random value; never commit the real one.
TRACKER_WEBHOOK_SECRET=
# Tracker buses start and end trips by themselves (false = a manager starts them).
TRACKER_AUTO_TRIPS=true
# A trip starts once the bus is this far (m) from where it stood.
TRIP_AUTO_START_M=500
# It ends when the bus stays within TRIP_AUTO_PARK_M for TRIP_AUTO_PARK_MINUTES.
TRIP_AUTO_PARK_M=150
TRIP_AUTO_PARK_MINUTES=10
# After a manager stops a tracker trip by hand, no automatic start for this long.
TRIP_AUTO_PAUSE_MINUTES=30
# Setting off within this distance (m) of the college stop = a trip towards home.
TRIP_AUTO_COLLEGE_M=1500

# ── Chat encryption at rest ───────────────────────────
# Long random string. Chat message bodies are AES-256-GCM encrypted in MongoDB
# with a key derived from this. Changing it makes existing messages unreadable.
CHAT_ENCRYPTION_KEY=replace_with_a_long_random_string
# Earlier keys (comma-separated), used only to READ messages saved with them.
# Every server sharing one database must use the same CHAT_ENCRYPTION_KEY; put
# any key a server used before here instead of deleting it.
CHAT_ENCRYPTION_KEYS_OLD=

# ── Gate pass parent OTP ──────────────────────────────
# SMS sending switch. While false (the default) OTPs are still generated,
# stored and verified normally, nothing is sent, and Admins read them in
# Security & Logs → OTP. To go live: OTP_SMS_ENABLED=true, OTP_PROVIDER=college_sms
# and the SMS_* values below. OTPs only ever go to the student's registered
# parent mobile number from the database.
OTP_SMS_ENABLED=false
# Sender used when OTP_SMS_ENABLED=true: "college_sms" = the college SMS vendor
# (adapter in services/otp/providers/collegeSmsProvider.js, to be connected).
OTP_PROVIDER=college_sms
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=4
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Legacy development portal at /dev/otp (superseded by Security & Logs → OTP).
# Off in production unless set.
# DEV_OTP_PORTAL=true
# College SMS vendor — leave blank until the college provides them. Never commit real values.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
# Template ID of the "GATE PASS APPROVED" (student left campus) template.
SMS_EXIT_TEMPLATE_ID=
# Vendor endpoint. Must be https:// in production (the key is in the query string).
SMS_API_URL=https://bulksms.2020sms.com/vb/apikey.php
# Only if the vendor has no HTTPS endpoint: "true" lets production send over
# http:// (the key, parent number and OTP then travel unencrypted).
SMS_ALLOW_INSECURE_HTTP=false

# ── Gate pass return-to-campus location check ─────────
# The student's phone sends one GPS reading; the server decides. The reading
# must be within the radius of the college point, at most MAX_ACCURACY meters
# uncertain, and taken within MAX_AGE seconds of the server's clock.
COLLEGE_LATITUDE=13.263803
COLLEGE_LONGITUDE=80.108414
LOCATION_GEOFENCE_RADIUS_METERS=500
LOCATION_MAX_ACCURACY_METERS=50
LOCATION_MAX_AGE_SECONDS=30
# How long the return QR/code is valid after a successful location check.
RETURN_CREDENTIAL_MINUTES=15

# ── JNN Study Assistant (Groq) ────────────────────────
# Backend-only. Never put this key in the client/mobile apps or commit a real one.
# To rotate: replace the value here in your real .env and restart the server.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set to false to disable Groq browser_search (web research) entirely.
AI_WEB_SEARCH_ENABLED=true
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_OUTPUT_TOKENS=1500
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60
# Messages stored per conversation (oldest trimmed) / recent messages sent as context.
AI_MAX_CONVERSATION_MESSAGES=30
AI_HISTORY_MESSAGES=10
# Simultaneous Groq calls from this server, and how many may wait in line.
AI_MAX_CONCURRENT=20
AI_MAX_QUEUE=100
# Study-material excerpts retrieved per question.
AI_RAG_CHUNKS=6

# ── Console / emergency control (docs/CONSOLE.md) ──
# JSON status written by your backup job: {"lastBackupAt","lastVerifiedAt","lastResult"}.
BACKUP_STATUS_FILE=
# Break-glass: "normal" forces normal operation whatever the stored emergency mode.
PLATFORM_MODE_OVERRIDE=

# ── Console SOC & troubleshooting (docs/SOC.md) ──
# Set to false to stop recording errors (the health page then reports the pipeline as FAIL).
SOC_CAPTURE_ENABLED=true
# Label stored with every error and run (defaults to NODE_ENV), e.g. production / staging.
SOC_ENVIRONMENT=
# How long an error must stay quiet after "fix applied" before verification can pass (ms).
SOC_VERIFY_WINDOW_MS=900000
# Diagnostic runs at once in this process, and runs per IT support user per 15 min.
SOC_DIAG_MAX_CONCURRENT=3
SOC_RUN_RATE_LIMIT=60

# ── Skill Wallet (docs/SKILL_WALLET.md) ──
# Private file store for certificates and project images: "disk" (default in
# development, under SKILL_WALLET_PRIVATE_DIR) or "db" (MongoDB; default in production
# because hosted disks such as Render's are wiped on deploy). Never the public /uploads.
SKILL_WALLET_PRIVATE_STORAGE=
SKILL_WALLET_PRIVATE_DIR=private-uploads
# Signs short-lived, viewer-bound file URLs. When empty a key is derived from the access-token secret;
# set a separate random value (32+ chars) in production.
SKILL_WALLET_ASSET_URL_SECRET=
SKILL_WALLET_ASSET_URL_MINUTES=10
# Upload limits. Every NPTEL certificate is decoded and re-encoded to WebP on the server.
SKILL_WALLET_CERT_MAX_MB=5
SKILL_WALLET_IMAGE_MAX_MB=5
SKILL_WALLET_MAX_IMAGE_PIXELS=40000000
SKILL_WALLET_MAX_IMAGE_DIMENSION=8000
SKILL_WALLET_MIN_IMAGE_DIMENSION=64
SKILL_WALLET_WEBP_QUALITY=85
# Teams and housekeeping.
SKILL_WALLET_INVITE_EXPIRY_DAYS=14
SKILL_WALLET_MAX_TEAM_SIZE=8
SKILL_WALLET_ORPHAN_ASSET_HOURS=24
# Per-user rate limits (writes/min, uploads & invitations /10 min, comments /5 min,
# contact requests /hour) and the per-IP public gallery limit (/min).
SKILL_WALLET_WRITE_LIMIT=60
SKILL_WALLET_UPLOAD_LIMIT=20
SKILL_WALLET_INVITE_LIMIT=20
SKILL_WALLET_COMMENT_LIMIT=20
SKILL_WALLET_CONTACT_LIMIT=10
SKILL_WALLET_PUBLIC_LIMIT=300

# Minutes of inactivity before a STUDENT's web session is signed out (default 2, range 1-1440).
# Staff roles (faculty, HOD, admin, ...) and the mobile apps are not affected.
WEB_IDLE_TIMEOUT_MINUTES=2

# ── AI Doubts (self-hosted model, server/ai) ─────────────────────────
# ON/OFF switch: true = AI Doubts tab works, false = switched off for everyone.
# Restart the API after changing it.
# Emergency stop (IT support → Console → Troubleshooting → AI Doubts) is separate:
# it overrides this switch, and only `npm run ai:resume` on the server turns AI back on.
# Terminal: npm run ai:status | npm run ai:stop -- "reason" | npm run ai:resume
LOCAL_AI_ENABLED=false
LOCAL_AI_MODEL=jnn-study

# Credits — ON/OFF: true = students spend credits, false = unlimited for everyone.
# Per student (roles below): monthly credits (reset on the 1st, no rollover) and a daily cap.
# Cost is set by the answer's real size: short <=100 words, normal <=300, long >300;
# an instant (cached) answer is cheap; refusals and errors are free. Staff are unlimited.
LOCAL_AI_CREDITS_ENABLED=false
LOCAL_AI_CREDITS_MONTHLY=1000
LOCAL_AI_CREDITS_DAILY=150
LOCAL_AI_CREDIT_COST_SHORT=5
LOCAL_AI_CREDIT_COST_NORMAL=10
LOCAL_AI_CREDIT_COST_LONG=15
LOCAL_AI_CREDIT_COST_CACHED=2
LOCAL_AI_CREDITS_LOW_WARNING=100
LOCAL_AI_CREDITS_ROLES=student,club_admin

# Chats: questions per chat, and how far back (minutes) the model remembers a chat.
LOCAL_AI_MAX_QUESTIONS_PER_CHAT=50
LOCAL_AI_MEMORY_MINUTES=30

# Misuse: prompt attacks / questions about the servers or database / sexual requests
# are strikes. N strikes in the window block only that student for LOCAL_AI_BLOCK_HOURS.
LOCAL_AI_STRIKES_TO_BLOCK=3
LOCAL_AI_STRIKE_WINDOW_HOURS=24
LOCAL_AI_BLOCK_HOURS=24
# Tripwire: an answer containing secrets / the database host / the hidden prompt
# switches AI off for everyone until `npm run ai:resume`. Keep true.
LOCAL_AI_TRIPWIRE=true

# Load: answer length (tokens) — short first, "Explain in detail" for the long one.
LOCAL_AI_SHORT_OUTPUT_TOKENS=260
LOCAL_AI_MAX_OUTPUT_TOKENS=700
# Exam answers ("explain … for 13 marks"): length follows the marks, up to this.
LOCAL_AI_EXAM_OUTPUT_TOKENS=1400
# Long exam answers on a CPU can take a few minutes.
LOCAL_AI_TIMEOUT_MS=300000
LOCAL_AI_CONTEXT_TOKENS=8192
# Several Ollama servers (e.g. one per CPU socket), comma separated, localhost only:
# LOCAL_AI_URLS=http://127.0.0.1:11434,http://127.0.0.1:11435
# Answers generated at once per server, and how many may wait in the fair queue.
LOCAL_AI_MAX_CONCURRENT=1
LOCAL_AI_MAX_QUEUE=30
# When this many are waiting, answers get shorter and use the faster model (if set).
LOCAL_AI_FALLBACK_QUEUE=6
LOCAL_AI_FALLBACK_MODEL=
LOCAL_AI_BUSY_OUTPUT_TOKENS=400
# Same question + same materials → instant answer for everyone, for this many hours (0 = off).
LOCAL_AI_ANSWER_CACHE_HOURS=168
