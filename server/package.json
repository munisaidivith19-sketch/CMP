{
  "name": "campusconnect-server",
  "version": "1.0.0",
  "description": "CampusConnect API — Express + MongoDB + Socket.io",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:academic": "node src/seed/academic.js",
    "seed:alumni": "node src/seed/alumniUsers.js",
    "migrate:academic": "node scripts/migrate-academic-year.mjs",
    "migrate:break-periods": "node scripts/fix-break-periods.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "ai:status": "node ai/aictl.mjs status",
    "ai:stop": "node ai/aictl.mjs stop",
    "ai:resume": "node ai/aictl.mjs resume"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.2.0",
    "file-type": "^22.3.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.9"
    }
  }
}
